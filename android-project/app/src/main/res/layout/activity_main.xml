<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Status Bar & Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI AC QUICKTIMER"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điều Khiển Hồng Ngoại"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 TABS SWITCHER (GIỐNG HỆT DEMO) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/tab_bar_bg"
        android:padding="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_routine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_orange_round"
            android:gravity="center"
            android:text="⚡ 1-Chạm"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_remote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎮 Remote Mi"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_pairing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍 Dò Mã"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_widget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📱 Widget"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTAINER CHỨA 3 MÀN HÌNH -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========================================== -->
        <!-- VIEW 1: ONE-CLICK ROUTINE                  -->
        <!-- ========================================== -->
        <ScrollView
            android:id="@+id/view_routine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngữ cảnh nhanh"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phát lệnh đầy đủ kèm hẹn giờ chỉ với 1 lần bấm"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <!-- Card Thiết bị Đang Chọn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/card_bg"
                        android:gravity="center"
                        android:text="❄️"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_active_brand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Funiki (Hòa Phát)"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_active_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mã: Funiki R32 Inverter"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_switch_to_pairing"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:text="Đổi mã"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thẻ Lớn Hẹn Giờ 7:30 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MỤC TIÊU HẸN GIỜ TẮT"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_target_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="07:30"
                        android:textColor="@color/text_white"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_countdown_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/card_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Cách hiện tại: Đang tính..."
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp" />

                    <!-- Nút Bật Hẹn Giờ Cam To Tròn -->
                    <Button
                        android:id="@+id/btn_trigger_timer"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_orange_round"
                        android:backgroundTint="@null"
                        android:text="⚡ Bật Hẹn Giờ 7:30 Ngay"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Quick Settings: Nhiệt độ + Quạt -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Item Temp -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/card_bg"
                            android:padding="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NHIỆT ĐỘ"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_temp_display"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="26°C"
                                    android:textColor="@color/text_white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_temp_minus"
                                    android:padding="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/btn_mini_temp"
                                    android:backgroundTint="@null"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_temp_plus"
                                    android:padding="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/btn_mini_temp"
                                    android:backgroundTint="@null"
                                    android:text="+"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item Mode -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/card_bg"
                            android:padding="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHẾ ĐỘ &amp; QUẠT"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mode_fan_display"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:gravity="center_vertical"
                                android:text="COOL / AUTO"
                                android:textColor="@color/text_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick actions: Nguồn, Quạt, Đảo Gió & Hủy Hẹn Giờ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- Hàng 1: Nút Bật & Nút Tắt -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_quick_power_on"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/btn_green_round"
                            android:backgroundTint="@null"
                            android:text="BẬT MÁY"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_quick_power_off"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/btn_red_card"
                            android:backgroundTint="@null"
                            android:text="TẮT MÁY"
                            android:textColor="@color/accent_red"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hàng 2: Tốc độ quạt & Đảo gió Swing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_fan_speed"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/btn_card_button"
                            android:backgroundTint="@null"
                            android:text="Gió: Auto"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_swing"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/btn_card_button"
                            android:backgroundTint="@null"
                            android:text="Đảo Gió (Swing)"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hàng 3: Hủy hẹn giờ -->
                    <Button
                        android:id="@+id/btn_quick_cancel_timer"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_card_button"
                        android:backgroundTint="@null"
                        android:text="HỦY HẸN GIỜ"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ========================================== -->
        <!-- VIEW 2: PAIRING / DÒ SÓNG (GIỐNG HỆT DEMO) -->
        <!-- ========================================== -->
        <ScrollView
            android:id="@+id/view_pairing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Chọn thương hiệu điều hòa:"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Trigger chọn hãng dạng Card giống demo -->
                <LinearLayout
                    android:id="@+id/brand_selector_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_brand_logo_letter"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/btn_orange_round"
                        android:gravity="center"
                        android:text="F"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_brand_picker_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Funiki (Hòa Phát)"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_brand_picker_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 bộ mã có sẵn"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Hộp Dò Sóng (Pairing Box) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge số mã -->
                    <TextView
                        android:id="@+id/tv_pairing_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tab_bar_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ĐANG THỬ: MÃ 1 / 4"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_pairing_code_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Funiki R32 Inverter (Midea RG57 48-bit)"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:text="Chĩa đỉnh điện thoại vào điều hòa và bấm nút nguồn bên dưới:"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:gravity="center" />

                    <!-- NÚT NGUỒN TO TRÒN SVG CHUẨN DEMO -->
                    <ImageButton
                        android:id="@+id/btn_test_power_round"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/btn_power_circle"
                        android:src="@drawable/ic_power_svg"
                        android:contentDescription="Phát tín hiệu hồng ngoại"
                        android:scaleType="centerInside"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bấm để phát tín hiệu Bật/Tắt thử nghiệm"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="14dp" />

                    <!-- Câu hỏi phản hồi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điều hòa có kêu 'BÍP' hoặc Bật/Tắt không?"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- NÚT DÒ TỰ ĐỘNG AUTO-SCAN LỚN MÀU XANH -->
                    <Button
                        android:id="@+id/btn_auto_scan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_green_round"
                        android:backgroundTint="@null"
                        android:text="▶ BẮT ĐẦU DÒ TỰ ĐỘNG (AUTO-SCAN)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_pair_no_next"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/btn_red_round"
                            android:backgroundTint="@null"
                            android:text="❌ Không, mã tiếp"
                            android:textColor="@color/accent_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_pair_yes_confirm"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1.2"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/btn_green_round"
                            android:backgroundTint="@null"
                            android:text="✅ Có! Chọn mã này"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="💡 Dò sóng trực tiếp: bấm nút Nguồn, nếu máy lạnh Funiki phản hồi kêu BÍP thì nhấn 'Chọn mã này' để lưu lại!"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>
        </ScrollView>

        <!-- ========================================== -->
        <!-- VIEW 3: WIDGET SCREEN                      -->
        <!-- ========================================== -->
        <ScrollView
            android:id="@+id/view_widget"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiện ích ngoài Màn hình chính"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bấm 1 chạm từ màn hình Redmi mà không cần mở ứng dụng"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp" />

                <!-- Widget Preview Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_bg"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_orange_round"
                        android:gravity="center"
                        android:text="⚡"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hẹn Giờ 7:30 Sáng"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chạm 1 cái phát tia IR tắt máy lúc 7:30"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Cách thêm Widget ngoài Home Screen:"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Về màn hình chính điện thoại Redmi.\n2. Chạm giữ vào vùng trống bất kỳ trên màn hình.\n3. Chọn mục 'Tiện ích' (Widgets).\n4. Tìm ứng dụng 'AC QuickTimer' và kéo widget ra màn hình.\n5. Xong! Mỗi tối chỉ cần chạm 1 cái là tự hẹn giờ 7:30."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- ========================================== -->
        <!-- VIEW 4: MI REMOTE - CLONE APP MI REMOTE (DARK) -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/view_remote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#141414"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Vùng hiển thị trạng thái: nhiệt độ + chế độ + trạng thái gió -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mi_tv_display_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="26"
                        android:textColor="#4A4A4A"
                        android:textSize="88sp" />

                    <!-- °C góc trên, chế độ góc dưới -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mi_tv_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="°C"
                            android:textColor="#4A4A4A"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/mi_tv_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off"
                            android:textColor="#A8A8A8"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hàng trạng thái Speed / Direction / Swing -->
                <LinearLayout
                    android:id="@+id/mi_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.45"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mi_tv_status_speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="▤ Speed Auto"
                        android:textColor="#8A8A8A"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="→ Direction Manual"
                        android:textColor="#8A8A8A"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/mi_tv_status_swing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="≋ Fixed"
                        android:textColor="#8A8A8A"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bàn phím lưới phẳng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hàng 1: Nguồn | Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/mi_btn_power"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/mi_grid_cell"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/mi_iv_power_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Bật/Tắt nguồn"
                            android:src="@drawable/ic_power_gray" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/mi_btn_mode"
                        style="@style/MiKey"
                        android:text="Mode" />
                </LinearLayout>

                <!-- Hàng 2: Speed | Direction | Swing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mi_btn_speed"
                        style="@style/MiKey"
                        android:text="Speed" />

                    <Button
                        android:id="@+id/mi_btn_direction"
                        style="@style/MiKey"
                        android:text="Direction" />

                    <Button
                        android:id="@+id/mi_btn_swing"
                        style="@style/MiKey.Dim"
                        android:text="Swing" />
                </LinearLayout>

                <!-- Hàng 3: − | Temp | + -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mi_btn_temp_down"
                        style="@style/MiKey.Big"
                        android:text="−" />

                    <Button
                        android:id="@+id/mi_btn_temp_click"
                        style="@style/MiKey"
                        android:text="Temp" />

                    <Button
                        android:id="@+id/mi_btn_temp_up"
                        style="@style/MiKey.Big"
                        android:text="+" />
                </LinearLayout>

                <!-- Hàng 4: Timer | Sleep | ••• -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mi_btn_timer"
                        style="@style/MiKey.Dim"
                        android:text="Timer" />

                    <Button
                        android:id="@+id/mi_btn_sleep"
                        style="@style/MiKey.Dim"
                        android:text="Sleep" />

                    <Button
                        android:id="@+id/mi_btn_more"
                        style="@style/MiKey.Dim"
                        android:text="···" />
                </LinearLayout>

                <!-- Hàng phím phụ, mở bằng ••• -->
                <LinearLayout
                    android:id="@+id/mi_extra_row"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/mi_btn_turbo"
                        style="@style/MiKey"
                        android:text="Turbo" />

                    <Button
                        android:id="@+id/mi_btn_led"
                        style="@style/MiKey"
                        android:text="Light" />

                    <Button
                        android:id="@+id/mi_btn_clean"
                        style="@style/MiKey"
                        android:text="Clean" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
